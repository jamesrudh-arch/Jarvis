# JARVIS NEXUS — Environment Configuration Template
# Copy to .env and customize. Never commit real secrets to Git.

# Database: PostgreSQL + pgvector in production; SQLite for local dev/tests
# Production example: DATABASE_URL=postgresql+psycopg://jarvis:password@localhost:5432/jarvis_nexus
DATABASE_URL=sqlite:///./backend/data/jarvis_nexus.db

# Optional Supabase PostgreSQL sync connection string (not model hosting, not required locally)
SUPABASE_DB_URL=

# Server bind configuration
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000

# Shared Private Worker Authentication Token (used by Local PC & Kaggle Secrets JARVIS_WORKER_TOKEN)
# If unset, CORE generates and persists a random 256-bit token locally in .jarvis_secret_key
JARVIS_WORKER_TOKEN=

# Default model for Local PC & Kaggle GPU private workers
JARVIS_DEFAULT_MODEL=huihui-ai/Qwen2.5-14B-Instruct-abliterated

# Optional external OpenAI-compatible or local Ollama endpoint (NEVER required)
OPTIONAL_OPENAI_BASE_URL=
OPTIONAL_OPENAI_API_KEY=
OPTIONAL_OPENAI_MODEL=

# Optional genuine video-generation backend webhook/endpoint (NEVER required or faked)
OPTIONAL_VIDEO_GEN_ENDPOINT=
OPTIONAL_VIDEO_GEN_API_KEY=
