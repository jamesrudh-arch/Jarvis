# JARVIS NEXUS — Environment Configuration Template
# Copy to .env locally or paste into Railway / Render environment variables.
# Never commit real secrets to Git.

# ---------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL + pgvector in production; SQLite locally)
# ---------------------------------------------------------------------------
# Paste your Supabase Connection String (Transaction Pooler port 6543 IPv4 recommended on Railway):
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Note: postgres:// and postgresql:// are normalized automatically to postgresql+psycopg://
DATABASE_URL=sqlite:///./backend/data/jarvis_nexus.db
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# 2. Server-Side Encryption & Private Worker Auth (Required in Production)
# ---------------------------------------------------------------------------
# Master encryption key/passphrase for Fernet vault (protects Kaggle secrets & sensitive memories across deploys)
JARVIS_SECRET_KEY=

# Shared Private Worker Authentication Token (also add to Kaggle Secrets as JARVIS_WORKER_TOKEN)
JARVIS_WORKER_TOKEN=

# ---------------------------------------------------------------------------
# 3. Network & Optional Split-Origin Configuration
# ---------------------------------------------------------------------------
JARVIS_HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Only needed on Vercel if hosting Frontend on Vercel separately from Railway CORE:
# VITE_CORE_URL=https://your-jarvis-core.up.railway.app

# ---------------------------------------------------------------------------
# 4. Private Inference Model & Optional Adapters
# ---------------------------------------------------------------------------
JARVIS_DEFAULT_MODEL=huihui-ai/Qwen2.5-14B-Instruct-abliterated

# Optional external OpenAI-compatible or local Ollama endpoint (NEVER required)
OPTIONAL_OPENAI_BASE_URL=
OPTIONAL_OPENAI_API_KEY=
OPTIONAL_OPENAI_MODEL=

# Optional genuine video-generation backend webhook/endpoint (NEVER required or faked)
OPTIONAL_VIDEO_GEN_ENDPOINT=
OPTIONAL_VIDEO_GEN_API_KEY=
